# ==========================================================================
#  Naresh Palem — Portfolio — Environment Configuration
# --------------------------------------------------------------------------
#  Copy this file to `.env` and edit the values. Every piece of personal data
#  on the site is read from here (or from src/data/*.js). You should NEVER
#  need to edit UI / section code to update your details.
#
#  All variables MUST start with `VITE_` so Vite exposes them to the browser.
#  `.env` is git-ignored, so your settings stay local. For Render, add the
#  same variables in the dashboard (Environment).
# ==========================================================================

# --- Identity -------------------------------------------------------------
VITE_FULL_NAME="Naresh Palem"
VITE_SHORT_NAME="Naresh"
VITE_TITLE="Data Analyst & Power BI Developer"
VITE_EXPERIENCE_YEARS="4+"
VITE_CURRENT_COMPANY="Cognit Analytics Solutions"
VITE_LOCATION="Hyderabad, India"

# --- Contact --------------------------------------------------------------
VITE_EMAIL="nareshpalem1644@gmail.com"
VITE_PHONE="+91 97032 19526"
VITE_PHONE_RAW="+919703219526"      # used for tel: links
VITE_WHATSAPP="919703219526"        # digits only, country code first

# --- Photos (files live in frontend-app/public/images) --------------------
VITE_PORTRAIT="/images/naresh.jpg"
VITE_PORTRAIT_ICON="/images/naresh-icon.png"

# --- Social (⚠️ LinkedIn / GitHub / Facebook are placeholders) -------------
VITE_LINKEDIN="https://www.linkedin.com/in/naresh-palem"
VITE_GITHUB="https://github.com/Nareshpalem1644"
VITE_FACEBOOK="https://www.facebook.com/naresh.palem"

# --- Site URL (set after your Render deploy) ------------------------------
VITE_WEBSITE="https://naresh-portfolio-pm4f.onrender.com"

# --- Theme (hex colors) ----------------------------------------------------
VITE_THEME_PRIMARY="#2E8DFF"
VITE_THEME_SECONDARY="#14B8A6"
VITE_THEME_ACCENT="#7DB6FF"

# --- Copy / Marketing -----------------------------------------------------
VITE_HERO_TAGLINE="I turn messy operational data into clear, decision-ready dashboards — 4+ years building Power BI models, DAX measures and reports that people actually use."
VITE_FOOTER_TEXT="Turning data into decisions."

# --- SEO ------------------------------------------------------------------
VITE_SEO_TITLE="Naresh Palem — Data Analyst & Power BI Developer"
VITE_SEO_DESCRIPTION="Data Analyst & Power BI Developer with 4+ years building star-schema models, advanced DAX measures, Power Query pipelines and Power BI Service dashboards."

# --- Deployment (optional) ------------------------------------------------
# Set to "/<repo-name>/" for GitHub Pages project sites, otherwise leave "/".
VITE_BASE_PATH="/"